{
    "name": "runai-e2e",
    "version": "0.0.0",
    "type": "module",
    "description": "e2e package",
    "scripts": {
        "api-codegen": "node api-codegen.mjs",
        "api-codegen-all": "node api-codegen.mjs --all",
        "format": "./node_modules/.bin/prettier --config .prettierrc 'src/**/*.ts' --write",
        "linter": "./node_modules/.bin/eslint --ignore-path .eslintignore . --fix --quiet",
        "typecheck": "tsc --noEmit",
        "test:unit": "playwright test --config playwright-config/unit.config.ts",
        "playwright-tests": "npx playwright test",
        "playwright:parallel": "playwright test --grep '@parallel-ci'",
        "playwright:serial": "playwright test --grep '@serial-ci'",
        "allure:generate": "allure generate allure-results --clean -o allure-report",
        "allure:serve": "allure serve",
        "slack-failures-and-skips": "npx ts-node --esm aggregateResultsPerTeam",
        "api-codegen-backendApi": "node api-codegen.mjs backendApi",
        "api-codegen-assetsApi": "node api-codegen.mjs assetsApi",
        "api-codegen-projectsDepartmentsApi": "node api-codegen.mjs projectsDepartmentsApi",
        "api-codegen-backendClusterApi": "node api-codegen.mjs backendClusterApi",
        "api-codegen-tenantsManagerApi": "node api-codegen.mjs tenantsManagerApi",
        "api-codegen-authorizationApi": "node api-codegen.mjs authorizationApi",
        "api-codegen-clusterApi": "node api-codegen.mjs clusterApi",
        "api-codegen-identityManagerApi": "node api-codegen.mjs identityManagerApi",
        "api-codegen-k8sObjectsTrackerApi": "node api-codegen.mjs k8sObjectsTrackerApi",
        "api-codegen-policyApi": "node api-codegen.mjs policyApi",
        "api-codegen-orgUnitApi": "node api-codegen.mjs orgUnitApi",
        "api-codegen-workloadsApi": "node api-codegen.mjs workloadsApi",
        "api-codegen-workloadsManagerApi": "node api-codegen.mjs workloadsManagerApi",
        "api-codegen-auditApi": "node api-codegen.mjs auditApi",
        "api-codegen-cliExposerApi": "node api-codegen.mjs cliExposer",
        "api-codegen-notificationsProxyApi": "node api-codegen.mjs notificationsProxyApi",
        "api-codegen-catalogApi": "node api-codegen.mjs catalogApi",
        "api-codegen-tempBackendSettingsApi": "node api-codegen.mjs tempBackendSettingsApi",
        "api-codegen-bffServiceApi": "node api-codegen.mjs bffServiceApi",
        "api-codegen-check": "node api-codegen.mjs --all --check",
        "api-codegen-datavolumesApi": "node api-codegen.mjs datavolumesApi",
        "api-codegen-backendUndocumentedApi": "node api-codegen.mjs backendUndocumentedApi"
    },
    "author": "",
    "license": "Apache-2.0",
    "dependencies": {
        "@kubernetes/client-node": "^1.4.0",
        "@playwright/test": "^1.56.0",
        "@types/chai": "^4.3.3",
        "@types/pg": "^8.15.4",
        "allure-playwright": "^3.4.5",
        "archiver": "^7.0.1",
        "await-spawn": "^4.0.2",
        "axios": "^0.33.0",
        "chai": "^4.3.6",
        "cross-spawn": "^7.0.3",
        "crypto": "^1.0.1",
        "crypto-js": "^4.1.1",
        "dotenv": "^16.0.1",
        "git-branch": "^2.0.1",
        "http-status-codes": "^2.2.0",
        "js-yaml": "^4.3.0",
        "jwt-decode": "^3.1.2",
        "keycloak-admin": "^1.14.22",
        "lodash-es": "^4.17.21",
        "mysql2": "^3.14.1",
        "node-forge": "^1.4.0",
        "node-pty": "^1.0.0",
        "nodemailer": "^9.0.4",
        "openid-client": "^5.6.5",
        "pg": "^8.16.0",
        "qs": "6.14.1",
        "request": "^2.88.2",
        "semver-compare": "^1.0.0",
        "shelljs": "^0.8.5",
        "smtp-server": "^3.19.2",
        "tar": "^7.5.19",
        "test-results-reporter": "^1.0.15",
        "typescript": "^4.8.2",
        "uuid": "^8.3.2",
        "winston": "^3.8.1"
    },
    "overrides": {
        "request": {
            "qs": "$qs",
            "form-data": "^2.5.6"
        },
        "keycloak-admin": {
            "axios": "$axios"
        },
        "brace-expansion": "^5.0.9",
        "braces": "^3.0.3",
        "fast-xml-builder": "^1.3.0",
        "form-data": "^4.0.6",
        "ip-address": "^10.4.0",
        "micromatch": "^4.0.8",
        "ws": "^8.21.2"
    },
    "devDependencies": {
        "@types/crypto-js": "^4.1.1",
        "@types/git-branch": "^2.0.2",
        "@types/lodash": "^4.14.197",
        "@types/lodash-es": "^4.17.12",
        "@types/node-forge": "^1.3.14",
        "@types/qs": "^6.14.0",
        "@types/semver-compare": "^1.0.1",
        "@types/smtp-server": "^3.5.10",
        "@typescript-eslint/eslint-plugin": "^8.21.0",
        "@typescript-eslint/parser": "^8.21.0",
        "allure-js-commons": "^3.3.0",
        "eslint": "8.57.0",
        "eslint-plugin-jest": "^28.11.0",
        "eslint-plugin-no-only-tests": "^3.1.0",
        "eslint-plugin-playwright": "^2.10.1",
        "prettier": "3.2.5",
        "ts-node": "^10.9.2"
    },
    "bin": "./cli.js"
}
