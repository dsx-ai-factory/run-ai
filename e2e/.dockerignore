yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# Ignore test results and reports
test-results/
test-results/*
playwright-report/
playwright-report/*
allure-results/
allure-results/*
allure-report/
allure-report/*
videos/
videos/*
logs/
logs/*
network-activity/
network-activity/*

# Ignore OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Ignore IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Ignore Git
.git/
.gitignore
.gitattributes

# Ignore Environment files (all variations)
.env
.env.*
.env-list
.envExample
*.env

# Ignore Build artifacts
*.tgz

# Ignore Temporary files
*.tmp
temp/
tmp/

