{
  "target": {
    "path": {
      "deployment": "runai-agent"
    },
    "namespace": "runai"
  },
  "feature": {
    "env": true,
    "fs": {
      "mode": "read",
      "read_only": [
        "/etc.*"
      ]
    },
    "network": {
      "incoming": {
          "mode": "steal"
        }
    }
  }
}
