{
  "target": {
    "path": {
      "deployment": "anyworkload-controller"
    },
    "namespace": "runai"
  },
  "feature": {
    "env": true,
    "fs": {
      "mode": "read",
      "read_only": [
        "/etc.*"
      ]
    },
    "network": {
      "incoming": {
        "mode": "steal"
      },
      "outgoing": {
        "tcp": true,
        "udp": true
      }
    }
  }
}
