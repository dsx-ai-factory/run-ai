FROM golang:1.26.3

RUN go install github.com/go-delve/delve/cmd/dlv@latest

WORKDIR /app
COPY runai-mutate .
RUN apt update && apt install ca-certificates && mkdir -p /app && chgrp -R 0 /app && chmod -R g=u /app
RUN chgrp -R 0 /app/runai-mutate && chmod -R g=u /app/runai-mutate

ENTRYPOINT ["/go/bin/dlv", "exec", "--headless", "-l", ":10000", "--api-version=2", "/app/runai-mutate", "--"]
