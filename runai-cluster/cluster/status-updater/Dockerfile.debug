FROM golang:1.26.3

RUN go install github.com/go-delve/delve/cmd/dlv@latest

COPY bin/status-updater-$TARGETARCH /usr/local/bin/status-updater
RUN chgrp -R 0 /usr/local/bin/status-updater && chmod -R g=u /usr/local/bin/status-updater

ENTRYPOINT ["/go/bin/dlv", "exec", "--headless", "-l", ":10000", "--api-version=2", "/usr/local/bin/status-updater", "--"]