FROM golang:1.26.3

RUN go install github.com/go-delve/delve/cmd/dlv@latest

WORKDIR /app
COPY bin/runai-job-controller .
RUN chgrp -R 0 runai-job-controller && chmod -R g=u runai-job-controller

ENTRYPOINT ["/go/bin/dlv", "exec", "--headless", "-l", ":10000", "--api-version=2", "/app/runai-job-controller", "--"]
