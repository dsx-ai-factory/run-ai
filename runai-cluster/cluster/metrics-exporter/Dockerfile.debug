ARG GO_VERSION
FROM golang:${GO_VERSION}
ARG TARGETARCH
ENV TARGETARCH=$TARGETARCH
RUN go install github.com/go-delve/delve/cmd/dlv@v1.27.2

ADD bin/metrics-exporter-$TARGETARCH /usr/local/bin/metrics_exporter
RUN chgrp -R 0 /usr/local/bin/metrics_exporter && chmod -R g=u /usr/local/bin/metrics_exporter

ENTRYPOINT ["/go/bin/dlv", "exec", "--headless", "-l", ":10000", "--api-version=2", "/usr/local/bin/metrics_exporter", "--"]
