            "$ref": "#/components/schemas/Tenant"
          },
          "additionalData": {
            "description": "additional data for tenant creation",
            "type": "object",
            "nullable": true
          }
        },
        "example": {
          "tenant": {
            "id": 1,
            "name": "example",
            "displayName": "Example",
            "status": "Ready",
            "tenantId": 123,
            "created_at": "2020-01-01T00:00:00Z",
            "updated_at": "2020-01-02T00:00:00Z",
            "deleted_at": null
          },
          "additionalData": {
            "tenantDomain": "tenant.example.com",
            "customerUser": {
              "user@tenant": "Abc!23"
            }
          }
        }
      },
      "TenantUpdateRequest": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "nullable": true,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*[a-zA-Z0-9]$",
            "description": "An optional alias for the tenant. Must be unique across all tenant names and aliases.",
            "example": "tenant-alias",
            "minLength": 2,
            "maxLength": 255
          }
        }
      },
      "LogoCreationRequest": {
        "type": "object",
        "required": [
          "logo"
        ],
        "properties": {
          "logo": {
            "type": "string",
            "description": "Base64 logo file",
            "minLength": 1,
            "maxLength": 500000
          }
        }
      },
