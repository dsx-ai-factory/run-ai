        "required": [
          "tenantId",
          "type",
          "datasourceId",
          "read",
          "write"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "description": "The id of the tenant.",
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          },
          "type": {
            "type": "string",
            "enum": [
              "grafanalabs",
              "mimir",
              "thanos"
            ]
          },
          "datasourceId": {
            "description": "Id of datasource",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "read": {
            "$ref": "#/components/schemas/MetricStoreEndpoint"
          },
          "write": {
            "$ref": "#/components/schemas/MetricStoreEndpoint"
          }
        }
      },
      "TenantLogo": {
        "type": "object",
        "required": [
          "tenantId",
          "logo"
        ],
        "properties": {
          "tenantId": {
            "type": "integer",
            "format": "int64"
          },
          "logo": {
            "type": "string",
            "description": "Data URL of the logo (e.g. \"data:image/png;base64,...\")"
          }
        }
      },
      "TenantLogosResponse": {
        "type": "object",
        "required": [
          "logos"
        ],
        "properties": {
          "logos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TenantLogo"
            }
          }
        }
      },
      "ComplianceIssues": {
        "properties": {
          "complianceIssues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "details",
                "field"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "example": "compute.gpuDevicesRequest"
                },
                "details": {
                  "type": "string",
                  "example": "value must be no less than 3"
                }
              }
            }
          }
        },
        "nullable": true,
        "type": "object"
