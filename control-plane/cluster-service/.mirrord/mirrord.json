{
    "target": {
        "path": {
            "deployment": "runai-backend-cluster-service"
        },
        "namespace": "runai-backend"
    },
    "feature": {
        "env": true,
        "fs": {
            "mode": "read",
            "read_only": [
                "/etc/secrets.*"
            ]
        },
        "network": {
            "incoming": {
                "mode": "steal"
            }
        }
    }
}