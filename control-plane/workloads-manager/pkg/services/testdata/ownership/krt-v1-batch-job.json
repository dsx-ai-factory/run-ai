{
  "apiVersion": "run.ai/v1alpha1",
  "kind": "Karta",
  "spec": {
    "optimizationInstructions": {},
    "structureDefinition": {
      "rootComponent": {
        "kind": {
          "group": "batch",
          "kind": "Job",
          "version": "v1"
        },
        "name": "job",
        "scaleDefinition": {
          "replicasPath": ".spec.parallelism // 1"
        },
        "specDefinition": {
          "podTemplateSpecPath": ".spec.template"
        },
        "statusDefinition": {
          "conditionsDefinition": {
            "messageFieldName": "message",
            "path": ".status.conditions",
            "reasonFieldName": "reason",
            "statusFieldName": "status",
            "typeFieldName": "type"
          },
          "statusMappings": {
            "completed": [
              {
                "byConditions": [
                  {
                    "status": "True",
                    "type": "Complete"
                  }
                ]
              }
            ],
            "failed": [
              {
                "byConditions": [
                  {
                    "status": "True",
                    "type": "Failed"
                  }
                ]
              }
            ],
            "initializing": [
              {
                "byExpression": {
                  "expectedResult": "true",
                  "expression": "(.status.active // 0) > 0 and (.status.ready == 0)"
                }
              }
            ],
            "running": [
              {
                "byExpression": {
                  "expectedResult": "true",
                  "expression": "(.status.active // 0) > 0"
                }
              },
              {
                "byExpression": {
                  "expectedResult": "true",
                  "expression": "(.status.active // 0) > 0 and (.status.ready // 0) > 0"
                }
              }
            ],
            "suspended": [
              {
                "byConditions": [
                  {
                    "status": "True",
                    "type": "Suspended"
                  }
                ]
              }
            ],
            "suspending": [
              {
                "byConditions": [
                  {
                    "status": "False",
                    "type": "Suspended"
                  }
                ],
                "byExpression": {
                  "expectedResult": "true",
                  "expression": ".spec.suspend == true and (.status.active // 0) > 0"
                }
              }
            ]
          }
        },
        "suspendDefinition": {
          "resumeActions": [
            {
              "path": ".spec.suspend",
              "value": "false"
            }
          ],
          "suspendActions": [
            {
              "path": ".spec.suspend",
              "value": "true"
            }
          ]
        }
      }
    }
  }
}
