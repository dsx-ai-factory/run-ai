          "value": "/code-repo1"
        },
        {
          "name": "GITSYNC_ONE_TIME",
          "value": "true"
        },
        {
          "name": "HOME",
          "value": "/tmp"
        }
      ],
      "resources": {},
      "volumeMounts": [
        {
          "name": "code-sync-0",
          "mountPath": "/code-repo1"
        }
      ]
    }
  ],
  "BuildGitSyncInitContainers parity Authentication scenarios should mirror cluster output for password authenticating method via secret / GetGitSyncInitContainers": [
    {
      "name": "git-sync-repo1",
      "image": "registry.example/git-sync:test",
      "env": [
        {
          "name": "GITSYNC_REPO",
          "value": "https://github.com/example/repo.git"
        },
        {
          "name": "GITSYNC_USERNAME",
          "valueFrom": {
            "secretKeyRef": {
              "name": "git-creds",
              "key": "username-key"
            }
          }
        },
        {
          "name": "GITSYNC_PASSWORD",
          "valueFrom": {
            "secretKeyRef": {
              "name": "git-creds",
              "key": "password-key"
            }
          }
        },
        {
          "name": "GITSYNC_ROOT",
          "value": "/code-repo1"
        },
        {
          "name": "GITSYNC_ONE_TIME",
          "value": "true"
        },
        {
          "name": "HOME",
          "value": "/tmp"
        }
      ],
      "resources": {},
      "volumeMounts": [
        {
          "name": "code-sync-0",
          "mountPath": "/code-repo1"
        }
      ]
    }
  ],
