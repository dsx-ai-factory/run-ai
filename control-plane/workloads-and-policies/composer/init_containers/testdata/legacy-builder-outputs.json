        "--extra-jwt-issuers=/auth/realms/runai=runai",
        "--custom-templates-dir=/usr/share/oauth2-proxy",
        "--pass-authorization-header=false",
        "--cookie-name=my-workload-url-0-auth-proxy",
        "--email-domain=*"
      ],
      "ports": [
        {
          "name": "port-4180",
          "containerPort": 4180,
          "protocol": "TCP"
        }
      ],
      "envFrom": [
        {
          "secretRef": {}
        }
      ],
      "env": [
        {
          "name": "OAUTH2_PROXY_COOKIE_PATH",
          "value": "/x"
        }
      ],
      "resources": {},
      "restartPolicy": "Always",
      "volumeMounts": [
        {
          "name": "runai-auth",
          "mountPath": "/etc/runai/auth/users"
