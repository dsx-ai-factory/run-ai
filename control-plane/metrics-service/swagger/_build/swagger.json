  "components": {
    "schemas": {
      "Filters": {
        "type": "object",
        "maxProperties": 100,
        "minProperties": 0,
        "additionalProperties": {
          "type": "array",
          "maxItems": 100,
          "minItems": 0,
          "items": {
            "type": "string"
          }
        }
      },
      "Range": {
        "type": "object",
        "nullable": true,
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "timestamp from when to fetch data in UTC",
            "example": "2023-06-07 12:09:18.211"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "description": "timestamp until when to fetch data in UTC",
            "example": "2023-06-07 12:09:18.211"
          }
        }
      },
      "Quantile": {
        "type": "number",
        "nullable": true,
        "description": "the quantile value to calculate",
        "example": 0.5,
        "minimum": 0,
        "maximum": 1
      },
      "MetricInformation": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 250,
            "minLength": 1
          },
          "filters": {
            "$ref": "#/components/schemas/Filters"
          },
          "responseLabels": {
            "type": "array",
            "maxItems": 100,
            "minItems": 0,
            "items": {
              "type": "string"
            }
          },
          "range": {
            "type": "object",
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Range"
              },
              {
                "type": "object",
                "properties": {
                  "numOfSamples": {
                    "type": "integer",
                    "default": 20,
                    "description": "the number of samples to take in the time range from start to end.",
                    "example": 20,
                    "maximum": 1000,
                    "minimum": 0
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "aggregation": {
                    "type": "boolean",
                    "default": false,
                    "description": "whether to aggregate the samples or not."
                  }
                }
              }
            ]
          },
          "quantile": {
            "$ref": "#/components/schemas/Quantile"
          }
        }
      },
      "Measurement": {
        "type": "object",
        "required": [
          "timestamp",
          "value"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2023-06-06 12:09:18.211"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "Result": {
        "type": "object",
        "required": [
          "metricLabels",
          "measurements"
        ],
        "properties": {
          "metricLabels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "measurements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Measurement"
            }
          }
        }
      },
      "Error": {
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        },
        "example": {
          "code": 400,
          "message": "Bad request - Resource should have a name"
        }
      },
      "ReportFilterAndSortFields": {
        "type": "string",
        "enum": [
          "name",
          "createdAt",
          "createdBy",
          "status"
        ]
      },
      "Label": {
        "type": "object",
        "required": [
          "name",
          "displayName"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "nodepoolName"
          },
          "displayName": {
            "type": "string",
            "example": "Node pool"
          }
        }
      },
      "ReportCommonFields": {
        "type": "object",
        "required": [
          "name",
          "range"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "2023 GPU report"
          },
          "description": {
            "type": "string",
            "example": "This report shows the GPU usage of all projects in the organization"
          },
          "labels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Label"
            }
          },
          "range": {
            "$ref": "#/components/schemas/Range"
          },
          "additionalFields": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "ReportStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Processing",
          "Ready",
          "Failed",
          "PendingDelete",
          "Deleting",
          "DeletionFailed"
        ]
      },
      "ReportCalculatedFields": {
        "type": "object",
        "required": [
          "id",
          "tenantId",
          "createdAt",
          "createdBy",
          "status",
          "statusUpdatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": "string",
            "example": "user@run.ai"
          },
          "tenantId": {
            "type": "integer",
            "format": "int32",
            "description": "ID of the tenant where the project is located.",
            "example": 2
          },
          "status": {
            "$ref": "#/components/schemas/ReportStatus"
          },
          "statusUpdatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "statusMessage": {
            "type": "string",
            "example": "Report in queue"
          }
        }
      },
      "Report": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ReportCommonFields"
          },
          {
            "$ref": "#/components/schemas/ReportCalculatedFields"
          }
        ]
      },
      "Reports": {
        "type": "Array",
        "items": {
          "$ref": "#/components/schemas/Report"
        }
      },
      "MetricInformationForReport": {
        "type": "object",
        "required": [
          "name",
          "displayName"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 250,
            "minLength": 1,
            "example": "gpu_allocation_hours"
          },
          "displayName": {
            "type": "string",
            "maxLength": 250,
            "minLength": 1,
            "example": "GPU allocation hours"
          },
          "filters": {
            "$ref": "#/components/schemas/Filters"
          },
          "quantile": {
            "$ref": "#/components/schemas/Quantile"
          }
        }
      },
      "ReportRequestFields": {
        "type": "object",
        "allOf": [
          {
            "type": "object",
            "required": [
              "metrics"
            ],
            "properties": {
              "metrics": {
                "type": "array",
                "maxItems": 100,
                "minItems": 1,
                "items": {
                  "$ref": "#/components/schemas/MetricInformationForReport"
                }
              }
            }
          },
          {
            "$ref": "#/components/schemas/ReportCommonFields"
          }
        ]
      },
      "IdsList": {
        "type": "array",
        "description": "List of ids to perform the action on.",
        "items": {
          "type": "string",
          "format": "uuid",
          "description": "Id to perform the action on."
        },
        "minLength": 1
      },
      "ReportsIdsBatchRequest": {
        "type": "object",
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "$ref": "#/components/schemas/IdsList",
            "maxItems": 100
          }
        }
      },
      "BatchId": {
        "type": "string",
        "format": "uuid",
        "description": "The ID of the batch operation."
      },
      "ErrorCode": {
        "type": "integer",
        "format": "int32",
        "description": "A numeric code representing the error type."
      },
      "ErrorMessage": {
        "type": "string",
        "description": "The error message."
      },
      "BatchResponseFailureItem": {
        "type": "object",
        "required": [
          "id",
          "code",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "$ref": "#/components/schemas/ErrorMessage"
          }
        }
      },
      "BatchResponseAsync": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/BatchId"
          },
          "accepted": {
            "$ref": "#/components/schemas/IdsList"
          },
          "failed": {
            "type": "array",
            "description": "The IDs that failed to update.",
            "items": {
              "$ref": "#/components/schemas/BatchResponseFailureItem"
            }
          }
        }
      },
      "ReportsBatchGetResponse": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/BatchId"
          },
          "succeeded": {
            "type": "array",
            "description": "Reports that were found for the tenant.",
            "items": {
              "$ref": "#/components/schemas/Report"
            }
          },
          "failed": {
            "type": "array",
            "description": "Report ids that could not be returned, with per-id error details.",
            "items": {
              "$ref": "#/components/schemas/BatchResponseFailureItem"
            }
          }
        }
      },
      "MetricStoreType": {
        "type": "string",
        "enum": [
          "grafanalabs",
          "mimir",
          "thanos"
        ]
      },
      "MetricStoreEndpointAuthType": {
        "type": "string",
        "enum": [
          "basic"
        ]
      },
      "MetricStoreEndpointAuthBasic": {
        "type": "object",
        "nullable": true,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 250
          },
          "password": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "MetricStoreEndpoint": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "format": "uri",
            "example": "http://mimir-nginx.mimir-test.svc:80/api/v1/query"
          },
          "auth": {
            "nullable": true,
            "type": "object",
            "properties": {
              "type": {
                "$ref": "#/components/schemas/MetricStoreEndpointAuthType"
              },
              "basic": {
                "$ref": "#/components/schemas/MetricStoreEndpointAuthBasic"
              }
            }
          },
          "headers": {
            "type": "object",
            "maxProperties": 20,
            "minProperties": 0,
            "additionalProperties": {
              "type": "string",
              "maxLength": 250,
              "minLength": 1
            },
            "example": {
              "X-Scope-OrgID": "abcd"
            }
          }
        }
      },
      "MetricStoreDetails": {
        "type": "object",
        "description": "Optional on create requests; always populated on responses. When null on create,\nthe metrics-service generates the metric store via the configured datasource provider.\n",
        "nullable": true,
        "required": [
          "type",
          "read",
          "write"
        ],
        "properties": {
          "type": {
            "$ref": "#/components/schemas/MetricStoreType"
          },
          "read": {
            "$ref": "#/components/schemas/MetricStoreEndpoint"
          },
          "write": {
            "$ref": "#/components/schemas/MetricStoreEndpoint"
          }
        }
      },
      "MetricStore": {
        "type": "object",
        "required": [
          "tenantId"
        ],
        "allOf": [
          {
            "type": "object",
            "properties": {
              "tenantId": {
                "description": "The id of the tenant.",
                "type": "integer",
                "format": "int32"
              },
              "datasourceId": {
                "description": "Id of the datasource. Optional - when empty, the metrics-service either\n(a) generates a new datasource via the configured provider when metricStoreDetails is null, or\n(b) saves an external metric store with datasourceId=\"external\" when metricStoreDetails is provided.\n",
                "type": "string",
                "maxLength": 255
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "metricStoreDetails": {
                "$ref": "#/components/schemas/MetricStoreDetails"
              }
            }
          }
        ]
      },
      "ComplianceIssues": {
        "properties": {
          "complianceIssues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "details",
                "field"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "example": "compute.gpuDevicesRequest"
                },
                "details": {
                  "type": "string",
                  "example": "value must be no less than 3"
                }
              }
            }
          }
        },
        "nullable": true,
        "type": "object"
      },
      "SubmissionError": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          },
          {
            "$ref": "#/components/schemas/ComplianceIssues"
          }
        ]
      }
    },
    "responses": {
