include ../../build/makefile/control-plane.mk
include ../../build/makefile/index.mk

# Change for every new service
SERVICE_NAME=notifications-service

REPO_DIR=$(shell pwd)
BIN_DIR=${REPO_DIR}/bin
MAIN_DIR=${REPO_DIR}/cmd/main.go

DOCKER_COMPOSE_FILE=./integration_tests/docker-compose.yaml
# The compose file builds the slack mock on the Go this module's go.mod asks for.
export GO_ALPINE_VERSION

OPENAPI_GENERATOR_VERSION_SERVER=v7.12.0
OPENAPI_GENERATOR_VERSION_CLIENT_GO=v7.12.0
OPENAPI_GENERATOR_VERSION=v7.22.0
OPENAPI_GENERATOR_ADDITIONAL_PROPERTY_ADD_RESPONSE_HEADERS=true

VERSIONED_CLIENT=true

GITHUB_REPO_NAME=run-ai
SHARED_PACKAGES_PATH=pkg
OPENAPI_CLIENT_NAME_GO=client
SHARED_PACKAGES_PATH_ABS=control-plane/notifications-service/pkg

OPENAPI_COMMON_PROPERTIES=--additional-properties outputAsLibrary=true \
						--additional-properties packageVersion=${GO_VERSION} \
						--additional-properties gitUserId=run-ai \
						--additional-properties gitRepoId=${SERVICE_NAME} \
						--additional-properties hideGenerationTimestamp=true

OPENAPI_GENERATOR_INTERNAL_CODE_PATH=
# check OPENAPI_GENERATOR_INTERNAL_CODE_PATH is empty!
OPENAPI_ADDITIONAL_PROPERTIES= \
             		--additional-properties sourceFolder=${OPENAPI_GENERATOR_INTERNAL_CODE_PATH} \
             		--additional-properties packageName=api \
             		--additional-properties router=chi

OPENAPI_GENERATOR_COMMAND=${DOCKER_COMMAND} \
                          openapitools/openapi-generator-cli:${OPENAPI_GENERATOR_VERSION} generate \
                          ${OPENAPI_COMMON_PROPERTIES}


#@ Basic Commands 
test: build test-go integration-tests ## Run unit and integration tests
.PHONY: test

lint: lint-go ## Run linter.
.PHONY: lint

validate: validate-mockery ## Run validate.
	# no-op
.PHONY: validate

purify: purify-go ## Purify the code.
.PHONY: purify

build: build_arm build_amd
.PHONY: build

build_arm: git-config-command generate-events-openapi-server generate-config-provider-openapi-server generate-config-provider-openapi-docs generate-events-openapi-client generate-history-openapi-server generate-history-openapi-client build-integration-tests
	sh "$(shell git rev-parse --show-toplevel)/build/makefile/scripts/spdx-header-openapi.sh" pkg/client/generated
	env GOOS=linux GOARCH=arm64 GOCACHE=/tmp/.cache GOLANGCI_LINT_CACHE=/tmp/.cache CGO_ENABLED=0 GO111MODULE=on \
	   go build -o ${BIN_DIR}/notifications-service-arm64 ${MAIN_DIR}

build_amd: git-config-command generate-events-openapi-server generate-config-provider-openapi-server generate-config-provider-openapi-docs generate-events-openapi-client generate-history-openapi-server generate-history-openapi-client build-integration-tests
	sh "$(shell git rev-parse --show-toplevel)/build/makefile/scripts/spdx-header-openapi.sh" pkg/client/generated
	env GOOS=linux GOARCH=amd64 GOCACHE=/tmp/.cache GOLANGCI_LINT_CACHE=/tmp/.cache CGO_ENABLED=0 GO111MODULE=on \
	   go build -o ${BIN_DIR}/notifications-service-amd64 ${MAIN_DIR}

##@ OpenAPI

generate-events-openapi-server:
	rm -rf ${REPO_DIR}/internal/listen/http/openapi/generated
	${OPENAPI_GENERATOR_COMMAND} \
		${OPENAPI_ADDITIONAL_PROPERTIES} \
        -i internal/listen/http/openapi/notifications.yaml \
		-o internal/listen/http/openapi/generated \
		-g go-server
	make fix-imports-on-autogenerated-code OUT_DIR=${REPO_DIR}/internal/listen/http/openapi/generated

generate-events-openapi-client: generate-events-openapi-client-notify generate-events-openapi-client-pg-provider

generate-events-openapi-client-notify:
	rm -rf ${REPO_DIR}/pkg/client/generated/notify
	${OPENAPI_GENERATOR_COMMAND} \
		--additional-properties packageName=events_http_client \
		-i internal/listen/http/openapi/notifications.yaml \
		-o pkg/client/generated/notify \
		-g go
	cd ${REPO_DIR}/pkg/client/generated/notify && \
		rm -rf ./git_push.sh  ./test ./go.mod ./go.sum  ./.travis.yml ./.openapi-generator* ./.gitignore && \
		go mod tidy

generate-events-openapi-client-pg-provider:
	rm -rf ${REPO_DIR}/pkg/client/generated/config_client
	${OPENAPI_GENERATOR_COMMAND} \
		--additional-properties packageName=config_client \
		-i internal/config/advanced/http_listener/openapi/listener_api.yaml \
		-o pkg/client/generated/config_client \
		-g go
	cd ${REPO_DIR}/pkg/client/generated/config_client && \
		rm -rf ./git_push.sh  ./test ./go.mod ./go.sum  ./.travis.yml ./.openapi-generator* ./.gitignore && \
		go mod tidy

generate-history-openapi-server:
	rm -rf ${REPO_DIR}/internal/history/openapi/generated
	${OPENAPI_GENERATOR_COMMAND} \
		${OPENAPI_ADDITIONAL_PROPERTIES} \
		-i ./internal/history/openapi/endpoints_config.yaml \
		-o ./internal/history/openapi/generated \
		-g go-server
	make fix-imports-on-autogenerated-code OUT_DIR=${REPO_DIR}/internal/history/openapi/generated

generate-history-openapi-client:
	rm -rf ${REPO_DIR}/pkg/client/generated/history
	${OPENAPI_GENERATOR_COMMAND} \
		--additional-properties packageName=history_client \
		-i ./internal/history/openapi/endpoints_config.yaml \
		-o pkg/client/generated/history \
		-g go
	cd ${REPO_DIR}/pkg/client/generated/history && \
		rm -rf ./git_push.sh  ./test ./go.mod ./go.sum  ./.travis.yml ./.openapi-generator* ./.gitignore && \
		go mod tidy

generate-config-provider-openapi-server:
	rm -rf ${REPO_DIR}/internal/config/advanced/http_listener/openapi/generated
	${OPENAPI_GENERATOR_COMMAND} \
		${OPENAPI_ADDITIONAL_PROPERTIES} \
		-i ./internal/config/advanced/http_listener/openapi/listener_api.yaml \
		-o ./internal/config/advanced/http_listener/openapi/generated \
		-g go-server
	make fix-imports-on-autogenerated-code OUT_DIR=${REPO_DIR}/internal/config/advanced/http_listener/openapi/generated

generate-config-provider-openapi-docs:
	rm -rf ${REPO_DIR}/internal/config/advanced/http_listener/openapi/docs
	${OPENAPI_GENERATOR_COMMAND} \
		--additional-properties packageName=docs \
		-i ./internal/config/advanced/http_listener/openapi/listener_api.yaml \
		-o ./internal/config/advanced/http_listener/openapi/docs \
		-g html
	${OPENAPI_GENERATOR_COMMAND} \
		--additional-properties packageName=docs \
		--additional-properties outputFileName=swagger.json \
		-i ./internal/config/advanced/http_listener/openapi/listener_api.yaml \
		-o ./internal/config/advanced/http_listener/openapi/docs \
		-g openapi
	${OPENAPI_GENERATOR_COMMAND} \
		--additional-properties packageName=docs \
		--additional-properties outputFile=swagger.yaml \
		-i ./internal/config/advanced/http_listener/openapi/listener_api.yaml \
		-o ./internal/config/advanced/http_listener/openapi/docs \
		-g openapi-yaml

fix-imports-on-autogenerated-code:
	docker run --rm \
		-v $(OUT_DIR):/local/code golang \
		    bash -c " \
		    go install golang.org/x/tools/cmd/goimports@latest && \
			goimports -w /local/code"

openapi-lint: openapi-lint-generic ## Lint the swagger bundle.
.PHONY: openapi-lint

local-deploy: export OS=linux
local-deploy: export ARCH=amd64
local-deploy: openapi-generate-code build-go docker-build-generic docker-push-generic
    ## Build and push the docker image.
.PHONY: local-deploy


#@ Integration tests
generate-integration-test-smtp-openapi-client:
	rm -rf ${REPO_DIR}/integration_tests/mailhog/mailhogclient
	${OPENAPI_GENERATOR_COMMAND} \
    	-i ./integration_tests/mailhog/api/openapi.yaml \
		-o ./integration_tests/mailhog/mailhogclient  \
		--additional-properties packageName=mailhogclient \
		--global-property modelDocs=false,apiDocs=false  \
		--git-repo-id mailhog --git-user-id smtp \
		-g go

	cd ${REPO_DIR}/integration_tests/mailhog/mailhogclient && \
		rm -rf ./git_push.sh  ./test ./go.mod ./go.sum  ./.travis.yml ./.openapi-generator* ./.gitignore && \
		go mod tidy && \
		go fmt ./...
	sh "$(shell git rev-parse --show-toplevel)/build/makefile/scripts/spdx-header-openapi.sh" integration_tests/mailhog/mailhogclient

INTEG_TESTS_PACKAGE=./integration_tests/tests/

build-integration-tests: build-integration-tests-generic
	docker image rm integration_tests-notifications-service --force
	docker image rm integration_tests-notification-integration-test --force
	docker compose -f $(DOCKER_COMPOSE_FILE) build

integration-tests: build-integration-tests
	docker compose -f $(DOCKER_COMPOSE_FILE) --profile "*" down --volumes --remove-orphans
	docker compose -f $(DOCKER_COMPOSE_FILE) --profile "*" up --remove-orphans --force-recreate --abort-on-container-exit

integration-tests-debug: build-integration-tests
	docker compose --profile service --profile postgres --profile smtp --profile slack -f $(DOCKER_COMPOSE_FILE) up --remove-orphans --force-recreate --abort-on-container-exit
