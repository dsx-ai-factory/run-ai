    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Bearer authentication"
      }
    },
    "schemas": {
      "Error": {
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        },
        "example": {
          "code": 400,
          "message": "Bad request - Resource should have a name"
        }
      },
      "Command": {
        "type": "object",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "example": "runai version",
            "description": "The commands that can be used to install the Run:ai CLI."
          }
        }
      },
      "Version": {
        "type": "object",
        "required": [
          "sdkVersion",
          "cpVersion",
          "needUpgrade"
        ],
        "properties": {
          "sdkVersion": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "example": "2.0.0",
            "description": "The version of the CLI SDK"
          },
          "cpVersion": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "example": "2.50.0",
            "description": "The version of the CP"
          },
          "needUpgrade": {
            "type": "boolean",
            "default": false,
            "example": false,
            "description": "Whether the CLI needs to be upgraded"
          }
        }
      },
      "ComplianceIssues": {
        "properties": {
          "complianceIssues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "details",
                "field"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "example": "compute.gpuDevicesRequest"
                },
                "details": {
                  "type": "string",
                  "example": "value must be no less than 3"
                }
              }
            }
          }
        },
        "nullable": true,
        "type": "object"
      },
      "SubmissionError": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          },
          {
            "$ref": "#/components/schemas/ComplianceIssues"
          }
        ]
      }
    },
    "parameters": {
      "OperatingSystem": {
        "name": "operatingSystem",
        "in": "path",
        "required": true,
        "description": "The operating system name.",
        "schema": {
          "type": "string",
          "enum": [
            "linux",
            "windows",
            "darwin"
          ],
          "maxLength": 7,
          "minLength": 4,
          "example": "linux"
        }
      },
      "Architecture": {
        "name": "architecture",
        "in": "path",
        "required": true,
        "description": "The architecture type.",
        "schema": {
          "type": "string",
          "maxLength": 10,
          "minLength": 4,
          "example": "arm64"
        }
      },
      "DocumentName": {
        "name": "documentName",
        "in": "path",
        "required": true,
        "description": "The manual document name.",
        "schema": {
          "type": "string",
          "maxLength": 255,
          "minLength": 4,
          "pattern": "^[A-Za-z0-9_]+\\.md$",
          "example": "runai.md"
        }
      }
    }
  }
