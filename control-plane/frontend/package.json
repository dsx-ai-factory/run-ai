{
  "name": "runai-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "test": "npm run test:unit:prod",
    "env:dev": "ENVIRONMENT=development npm run dev",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 5050",
    "test:unit": "vitest --environment jsdom",
    "test:unit:prod": "vitest run --environment jsdom",
    "typecheck": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "typecheck:threshold": "node scripts/typecheck-threshold.mjs",
    "lint:thresholds": "node scripts/eslint-thresholds.mjs",
    "lint:security": "npm run lint:thresholds",
    "lint": "npm i --save-dev && npm run format && ./node_modules/.bin/eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:local": "npm run format && ./node_modules/.bin/eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "./node_modules/.bin/prettier --check --config .prettierrc.json ./src",
    "format:write": "prettier --write --config .prettierrc.json ./src",
    "a11y:audit": "npm install --no-save puppeteer-core @axe-core/puppeteer && node scripts/a11y-audit-manual.mjs"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "@quasar/extras": "2.1.0",
    "@unleash/proxy-client-vue": "0.1.6",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.0",
    "@vue-flow/minimap": "^1.5.4",
    "@xterm/addon-attach": "^0.11.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.16.1",
    "compare-versions": "6.1.1",
    "date-fns": "4.4.0",
    "dompurify": "3.4.13",
    "echarts": "^6.0.0",
    "js-file-download": "0.4.12",
    "js-sha256": "1.0.0",
    "js-yaml": "5.4.2",
    "jwt-decode": "4.0.0",
    "monaco-editor": "0.41.0",
    "monaco-yaml": "5.5.0",
    "node-forge": "1.4.0",
    "pinia": "4.0.3",
    "quasar": "^2.15.0",
    "query-string": "9.5.1",
    "semver-compare": "1.0.0",
    "vue": "^3.5.26",
    "vue-dompurify-html": "5.3.0",
    "vue-echarts": "^8.0.1",
    "vue-draggable-plus": "0.6.1",
    "vue-router": "5.3.1",
    "vue3-lottie": "3.2.0"
  },
  "devDependencies": {
    "@pinia/testing": "2.0.1",
    "@quasar/vite-plugin": "2.0.2",
    "@rushstack/eslint-patch": "1.1.0",
    "@types/dompurify": "3.2.0",
    "@types/js-yaml": "4.0.9",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.2",
    "@types/node-forge": "1.3.14",
    "@types/qs": "^6.15.0",
    "@types/semver-compare": "^1.0.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.5.1",
    "esbuild": "^0.25.0",
    "eslint": "10.11.0",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-security": "4.0.0",
    "eslint-plugin-vue": "10.11.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "jsdom": "30.1.1",
    "minimatch": "^10.0.0",
    "prettier": "3.4.2",
    "qs": "^6.15.2",
    "sass": "1.93.3",
    "typescript": "7.0.2",
    "uuid": "^14.0.0",
    "vite": "8.3.0",
    "vite-plugin-monaco-editor": "1.1.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-svg-loader": "5.1.3",
    "vitest": "5.0.1",
    "vue-loader": "17.4.2",
    "vue-tsc": "^3.0.0"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "minimatch": "$minimatch",
    "qs": "$qs",
    "uuid": "$uuid"
  }
}
