# Run:AI Unified Load Test Configuration Template
# Copy this file and customize for your test scenario

# ==============================================================================
# CLUSTER IDENTIFICATION
# ==============================================================================

# Run:AI cluster ID (required)
# Get this from your Run:AI control plane
CLUSTER_ID=

# Scale group identifier for test organization
# Used for grouping related test runs in reporting
SCALE_GROUP=validation

# ==============================================================================
# CORE TEST PARAMETERS
# ==============================================================================

# Resource profile: small, medium, large, custom
# Controls Run:AI service resource allocation
# Use 'custom' to specify individual service resources below
RESOURCES=medium

# Number of projects to create in the cluster
# Each project gets separate resource quotas and scheduling priority
PROJECT_COUNT=50

# Total number of workloads to submit during the test
# Distributed across all projects
WORKLOAD_COUNT=1000

# Workload type: Training or Distributed
# Training: Single-pod training workloads
# Distributed: Multi-worker distributed training (requires WORKLOAD_WORKER_COUNT > 1)
WORKLOAD_TYPE=Training

# Number of worker pods per workload (for distributed training)
# Set to 1 for single-pod workloads
# Set to > 1 for distributed training workloads
WORKLOAD_WORKER_COUNT=1

# Distributed framework (only for Distributed workload type)
# Options: PyTorch, TensorFlow, MPI, XGBoost
# Leave empty for Training workload type
DISTRIBUTED_FRAMEWORK=

# ==============================================================================
# WORKLOAD BEHAVIOR CONFIGURATION
# ==============================================================================

# Run infinite workloads (true/false)
# true: Workloads run 'sleep infinity' and never complete (for sustained load testing)
# false: Workloads run for specified sleep times and complete
RUN_INFINITE_WORKLOADS=false

# Workload sleep times in seconds (comma-separated list)
# Only used when RUN_INFINITE_WORKLOADS=false
# Example: 180,300,600 creates workloads that sleep for 180s, 300s, or 600s
# Workloads cycle through these durations
WORKLOAD_SLEEP_TIMES=180

# ==============================================================================
# NODE POOL CONFIGURATION
# ==============================================================================
#
# THREE OPTIONS:
#
# Option A: Use pre-existing nodepools (recommended for existing clusters)
#   - Set NODEPOOL_COUNT=0
#   - Test will use all existing nodepools in your Run:AI cluster
#   - Requires: At least 1 nodepool already configured in Run:AI Control Plane
#
# Option B: Create KWOK virtual nodepools (recommended for scale testing)
#   - Set NODEPOOL_COUNT > 0 and KWOK_ENABLED=true
#   - Test creates virtual nodes using KWOK (no real hardware needed)
#   - Allows testing massive scale without cloud costs
#
# Option C: Create nodepools for real nodes
#   - Set NODEPOOL_COUNT > 0 and KWOK_ENABLED=false
#   - Test creates Run:AI nodepool configurations
#   - Requires: Real nodes with matching labels already exist in Kubernetes
#

# Number of distinct node pools to create
# Set to 0 to use pre-existing nodepools in your cluster
NODEPOOL_COUNT=1

# Number of nodes in each pool (only used when NODEPOOL_COUNT > 0)
# Total cluster nodes = NODEPOOL_COUNT * NODES_PER_POOL
NODES_PER_POOL=10

# Enable KWOK (Kubernetes WithOut Kubelet) for simulated nodes
# true: Test creates virtual nodes (no real hardware needed)
# false: Test expects real nodes to exist
KWOK_ENABLED=true

# ==============================================================================
# RESOURCE CONFIGURATION
# ==============================================================================

# GPU resources per workload
# Fractional values supported (e.g., 0.5 for GPU sharing)
GPU_PER_WORKLOAD=1

# GPU product types (comma-separated list, optional)
# Examples: NVIDIA-A100-SXM4-40GB,NVIDIA-H100-80GB
# Leave empty to use generic GPU labels
GPU_PRODUCT=

# CPU resources per workload (in cores, optional)
# Leave empty to use defaults based on RESOURCES profile
CPU_PER_WORKLOAD=

# Memory resources per workload (e.g., 4Gi, 8Gi, optional)
# Leave empty to use defaults based on RESOURCES profile
MEMORY_PER_WORKLOAD=

# ==============================================================================
# PROJECT LOAD DISTRIBUTION
# ==============================================================================

# Project load method: uniform or heavy
# uniform: Distribute workloads evenly across all projects
# heavy: Concentrate workloads in a subset of projects
PROJECT_LOAD_METHOD=uniform

# Number of projects to heavily load (only when PROJECT_LOAD_METHOD=heavy)
# These projects will receive more workloads than others
NUMBER_OF_PROJECTS_TO_HEAVY_LOAD=1

# ==============================================================================
# TIMEOUT CONFIGURATION
# ==============================================================================

# Timeout for project creation (e.g., 20m, 1h)
# How long to wait for all projects to become ready
PROJECT_CREATE_TIMEOUT=20m

# Timeout for workload creation (e.g., 20m, 1h)
# How long to wait for individual workload to be created
WORKLOAD_CREATE_TIMEOUT=20m

# ==============================================================================
# NODE CHAOS TESTING (ADVANCED)
# ==============================================================================

# Enable node chaos testing (random node failures during test)
# Tests scheduler resilience and workload recovery
NODE_CHAOS_ENABLED=false

# Number of nodes to fail during chaos testing
# Only applicable if NODE_CHAOS_ENABLED=true
NODE_CHAOS_COUNT=1

# Duration each node stays down (e.g., 5m, 10m)
# Only applicable if NODE_CHAOS_ENABLED=true
NODE_CHAOS_DOWN_DURATION=5m

# Node selector for chaos (label selector, e.g., nvidia.com/gpu.present=true)
# Only nodes matching this selector will be affected
NODE_CHAOS_NODE_SELECTOR=nvidia.com/gpu.present=true

# Delay before starting chaos (e.g., 2m, 5m)
# Gives time for workloads to start before introducing failures
NODE_CHAOS_START_DELAY=2m

# Delay between chaos events (e.g., 10s, 30s)
# Time between failing individual nodes
NODE_CHAOS_DELAY_BETWEEN=10s

# ==============================================================================
# RUN:AI CONTROL PLANE CONFIGURATION
# ==============================================================================

# Run:AI Control Plane URL
# Example: https://my-company.run.ai or http://localhost:8080
CONTROL_PLANE_URL=

# Run:AI Control Plane username (admin user)
CONTROL_PLANE_USERNAME=

# Run:AI Control Plane password
CONTROL_PLANE_PASSWORD=

# Control Plane API rate limit (queries per second)
# Limits the rate of API calls to the Run:AI Control Plane
CONTROL_PLANE_QPS=20

# ==============================================================================
# KUBERNETES CLIENT CONFIGURATION
# ==============================================================================

# Kubernetes API rate limit (queries per second)
# Limits the rate of API calls to the Kubernetes API server
KUBE_QPS=100

# Batch size for operations
# Number of resources to process in a single batch
BATCH_SIZE=100

# ==============================================================================
# PROMETHEUS MONITORING (OPTIONAL)
# ==============================================================================

# Enable Prometheus remote write for metrics export
# Sends test metrics to external Prometheus/monitoring system
PROMETHEUS_REMOTE_WRITE_ENABLED=false

# Prometheus remote write endpoint URL
# Required if PROMETHEUS_REMOTE_WRITE_ENABLED=true
# Example: https://prometheus.example.com/api/v1/write
PROMETHEUS_REMOTE_WRITE_URL=

# Prometheus remote write authentication (optional)
# Leave empty if your Prometheus endpoint doesn't require auth
PROMETHEUS_REMOTE_WRITE_USERNAME=
PROMETHEUS_REMOTE_WRITE_PASSWORD=

# ==============================================================================
# CLEANUP CONFIGURATION
# ==============================================================================

# Cleanup cluster after test completes (true/false)
# true: Remove all test resources (projects, workloads, nodepools)
# false: Leave test resources in place for inspection
CLUSTER_CLEANUP=true

# ==============================================================================
# VERSION INFORMATION (OPTIONAL)
# ==============================================================================

# Run:AI operator version (for metadata/reporting)
# Example: 2.18.0, dev
OPERATOR_VERSION=

# Run:AI control plane version (for metadata/reporting)
# Example: 2.18.0, dev
CP_VERSION=

# ==============================================================================
# GITHUB INTEGRATION (OPTIONAL)
# ==============================================================================

# GitHub actor (username who triggered the test)
# Used for tracking test runs from CI/CD
GITHUB_ACTOR=

# GitHub workflow URL
# Used for linking test results back to CI/CD workflow
GITHUB_WORKFLOW_URL=

# ==============================================================================
# CUSTOM RESOURCE SPECIFICATIONS (ONLY WHEN RESOURCES=custom)
# ==============================================================================
# When RESOURCES=custom, you must specify resource requests/limits
# for each Run:AI service component

# Scheduling Services
SCHEDULING_SERVICES_CPU_REQUEST=
SCHEDULING_SERVICES_CPU_LIMIT=
SCHEDULING_SERVICES_MEMORY_REQUEST=
SCHEDULING_SERVICES_MEMORY_LIMIT=

# Workload Services
WORKLOAD_SERVICES_CPU_REQUEST=
WORKLOAD_SERVICES_CPU_LIMIT=
WORKLOAD_SERVICES_MEMORY_REQUEST=
WORKLOAD_SERVICES_MEMORY_LIMIT=

# Sync Services
SYNC_SERVICES_CPU_REQUEST=
SYNC_SERVICES_CPU_LIMIT=
SYNC_SERVICES_MEMORY_REQUEST=
SYNC_SERVICES_MEMORY_LIMIT=

# Training Operator
TRAINING_OPERATOR_CPU_REQUEST=
TRAINING_OPERATOR_CPU_LIMIT=
TRAINING_OPERATOR_MEMORY_REQUEST=
TRAINING_OPERATOR_MEMORY_LIMIT=

# Fake GPU Operator (for KWOK nodes)
FAKE_GPU_OPERATOR_CPU_REQUEST=
FAKE_GPU_OPERATOR_CPU_LIMIT=
FAKE_GPU_OPERATOR_MEMORY_REQUEST=
FAKE_GPU_OPERATOR_MEMORY_LIMIT=

# PostgreSQL
POSTGRES_CPU_REQUEST=
POSTGRES_CPU_LIMIT=
POSTGRES_MEMORY_REQUEST=
POSTGRES_MEMORY_LIMIT=

# ==============================================================================
# NOTES
# ==============================================================================
# - All timing values use Go duration format (e.g., 5m, 1h30m, 30s)
# - GPU/CPU/Memory values follow Kubernetes resource notation
# - Boolean values: true/false (case-sensitive)
# - Empty values use system defaults
# - Lines starting with # are comments and ignored
# - For external client use: Focus on top sections, advanced options can use defaults
