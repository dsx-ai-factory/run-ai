# Large Scale Test Configuration
# Purpose: Extreme scale testing (~1-2 hours)
# Use case: Capacity planning, stress testing

# === FILL THESE IN ===
CLUSTER_ID=
CONTROL_PLANE_URL=
CONTROL_PLANE_USERNAME=
CONTROL_PLANE_PASSWORD=

# Core parameters
RESOURCES=large
PROJECT_COUNT=250
WORKLOAD_COUNT=10000
WORKLOAD_TYPE=Training
WORKLOAD_WORKER_COUNT=1

# Workload behavior
RUN_INFINITE_WORKLOADS=false
WORKLOAD_SLEEP_TIMES=180

# Node pool configuration (uses pre-existing nodepools)
NODEPOOL_COUNT=0
KWOK_ENABLED=false

# Resource configuration
GPU_PER_WORKLOAD=1

# Scale group identifier
SCALE_GROUP=large-validation

# Advanced features
NODE_CHAOS_ENABLED=false
PROMETHEUS_REMOTE_WRITE_ENABLED=false

# Cleanup
CLUSTER_CLEANUP=true
