# Medium Scale Test Configuration
# Purpose: Standard testing (~15-30 minutes)
# Use case: Production validation

# === FILL THESE IN ===
CLUSTER_ID=
CONTROL_PLANE_URL=
CONTROL_PLANE_USERNAME=
CONTROL_PLANE_PASSWORD=

# Core parameters
RESOURCES=medium
PROJECT_COUNT=50
WORKLOAD_COUNT=1000
WORKLOAD_TYPE=Training
WORKLOAD_WORKER_COUNT=1

# Workload behavior
RUN_INFINITE_WORKLOADS=false
WORKLOAD_SLEEP_TIMES=180

# Node pool configuration (uses pre-existing nodepools)
NODEPOOL_COUNT=0
KWOK_ENABLED=false

# Resource configuration
GPU_PER_WORKLOAD=1

# Scale group identifier
SCALE_GROUP=medium-validation

# Advanced features
NODE_CHAOS_ENABLED=false
PROMETHEUS_REMOTE_WRITE_ENABLED=false

# Cleanup
CLUSTER_CLEANUP=true
